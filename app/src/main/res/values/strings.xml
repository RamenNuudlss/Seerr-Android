    <string name="instant_header">Instant alerts</string>
    <string name="instant_switch">Instant new-request alerts</string>
    <string name="instant_summary_off">Get a notification within seconds of someone making a request, with Approve and Decline buttons. Uses Seerr\'s built-in ntfy notifications; Seerr admins can turn this on in one tap.</string>
    <string name="instant_summary_on">On. Seerr sends new requests to this ntfy topic and the app listens to it:</string>
