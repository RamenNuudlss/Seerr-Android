<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/seerr_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/seerr_bg"
        app:title="@string/settings_title"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/settings_server" />

            <TextView
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/seerr_text"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeServer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_change_server" />

            <View style="@style/SettingsDivider" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/notificationsSwitch"
                style="@style/SettingsSwitch"
                android:text="@string/settings_notifications" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_notifications_summary" />

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/instant_header" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/instantSwitch"
                style="@style/SettingsSwitch"
                android:layout_marginTop="0dp"
                android:text="@string/instant_switch" />

            <TextView
                android:id="@+id/instantSummary"
                style="@style/SettingsSummary"
                android:text="@string/instant_summary_off" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/instantProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/instantDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/instantTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/seerr_text"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/instantBattery"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/instant_battery_button" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/instantTest"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/instant_test" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/instantEdit"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/instant_edit" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/plexBrowserSwitch"
                style="@style/SettingsSwitch"
                android:text="@string/settings_plex_browser" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_plex_browser_summary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/pullRefreshSwitch"
                style="@style/SettingsSwitch"
                android:text="@string/settings_pull_refresh" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_pull_refresh_summary" />

            <View style="@style/SettingsDivider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdates"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_check_updates" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearData"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_clear_data"
                android:textColor="@color/seerr_error" />

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/seerr_text"
                android:textSize="15sp" />

            <TextView
                style="@style/SettingsSummary"
                android:text="@string/settings_disclaimer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/github"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/settings_github" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
